# --- Вход через Telegram-бота с одобрением администратора ---
# Пока переменные не заданы, защищённые разделы открыты без входа только в разработке, в production они отвечают 503.

# Секрет подписи сессии и кодов, не короче 32 символов. Например: openssl rand -base64 48
AUTH_SECRET=

# Postgres. Таблицы создаются сами при первом входе.
DATABASE_URL=

# Бот из @BotFather: токен и username (без @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Любая длинная случайная строка. Её же передаём в setWebhook как secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Telegram ID администраторов через запятую. Входят без одобрения и подтверждают заявки в боте и в панели.
TELEGRAM_ADMIN_IDS=

# --- Фоновая проверка правил ---
# База правил хранится в Postgres (нужен DATABASE_URL). Проверку запускает cron, а не сайт:
# GET|POST /api/rules/sync с заголовком Authorization: Bearer <CRON_SECRET>, раз в 3 часа.
# Готовые варианты: .github/workflows/rules-sync.yml (секреты SITE_URL и CRON_SECRET) или `npm run rules:sync`.
# Без CRON_SECRET в production эндпоинт закрыт.
CRON_SECRET=

# RULES_SYNC=internal включает запасное расписание внутри процесса сайта (если внешнего cron нет).
# Пусто — проверку запускает только внешний cron.
RULES_SYNC=

# Через сколько часов без успешной проверки раздел получает статус «Давно не проверялось». По умолчанию 9.
RULES_STALE_AFTER_HOURS=

# --- Адрес сайта ---
# Публичный адрес сайта без завершающего слэша: нужен для sitemap.xml и превью ссылок (Open Graph).
SITE_URL=
