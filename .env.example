# --- Вход через Telegram-бота с одобрением администратора ---
# Пока переменные не заданы, защищённые разделы открыты без входа только в разработке, в production они отвечают 503.

# Секрет подписи сессии и кодов, не короче 32 символов. Например: openssl rand -base64 48
AUTH_SECRET=

# Postgres. Таблицы создаются сами при первом входе.
DATABASE_URL=

# Бот из @BotFather: токен и username (без @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Любая длинная случайная строка. Её же передаём в setWebhook как secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Telegram ID администраторов через запятую. Входят без одобрения и подтверждают заявки в боте и в панели.
TELEGRAM_ADMIN_IDS=

# --- Автообновление правил с форума ---
# Работает, если задан DATABASE_URL: сайт сам проверяет форум раз в 3 часа и пишет изменения в историю.
# RULES_SYNC=off отключает встроенное расписание (например, если проверку запускает внешний cron).
RULES_SYNC=

# Секрет для ручного/внешнего запуска: GET /api/rules/sync с заголовком Authorization: Bearer <секрет>.
# Без него эндпоинт в production закрыт.
CRON_SECRET=

# --- Адрес сайта ---
# Публичный адрес сайта без завершающего слэша: нужен для sitemap.xml и превью ссылок (Open Graph).
SITE_URL=
