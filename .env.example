# --- Вход через Telegram-бота с одобрением администратора ---
# Пока переменные не заданы, защищённые разделы открыты без входа только в разработке, в production они отвечают 503.

# Секрет подписи сессии и кодов, не короче 32 символов. Например: openssl rand -base64 48
AUTH_SECRET=

# Postgres. Таблицы создаются сами при первом входе.
DATABASE_URL=

# Бот из @BotFather: токен и username (без @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Любая длинная случайная строка. Её же передаём в setWebhook как secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Telegram ID администраторов через запятую. Входят без одобрения и подтверждают заявки в боте и в панели.
TELEGRAM_ADMIN_IDS=

# --- Фоновая проверка правил ---
# База правил хранится в Postgres (нужен DATABASE_URL). Проверку запускает cron, а не сайт:
# GET|POST /api/rules/sync с заголовком Authorization: Bearer <CRON_SECRET>, раз в 3 часа.
# Готовые варианты: .github/workflows/rules-sync.yml (секреты SITE_URL и CRON_SECRET) или `npm run rules:sync`.
# Без CRON_SECRET в production эндпоинт закрыт.
CRON_SECRET=

# По умолчанию сайт сам проверяет правила раз в 3 часа (нужен постоянно работающий сервер).
# RULES_SYNC=external (или off) отключает встроенное расписание — например, если проверку запускает внешний cron.
# Гл.Администратор может запустить проверку вручную кнопкой в разделе правил.
RULES_SYNC=

# Через сколько часов без успешной проверки раздел получает статус «Давно не проверялось». По умолчанию 9.
RULES_STALE_AFTER_HOURS=

# --- Адрес сайта ---
# Публичный адрес сайта без завершающего слэша: нужен для sitemap.xml и превью ссылок (Open Graph).
SITE_URL=

# --- Поиск правил по смыслу (embedding API) ---
# Включается, когда задан EMBEDDINGS_API_KEY (нужен ещё DATABASE_URL). Без ключа работает только обычный умный поиск.
# Подходит любой сервис с OpenAI-совместимым методом /embeddings: OpenAI, Voyage, Mistral, OpenRouter или свой сервер.
# Векторы пунктов считаются один раз и хранятся в Postgres, при правке пункта пересчитывается только он.
EMBEDDINGS_API_KEY=
# Адрес метода. По умолчанию OpenAI. Например, Voyage: https://api.voyageai.com/v1/embeddings
EMBEDDINGS_API_URL=
# Модель. По умолчанию text-embedding-3-small. Для русского также хороши voyage-3, multilingual-e5, bge-m3.
EMBEDDINGS_MODEL=
# Приставки для моделей семейства e5 («query: » и «passage: »). Для остальных моделей оставьте пустыми.
EMBEDDINGS_QUERY_PREFIX=
EMBEDDINGS_DOCUMENT_PREFIX=
# Порог сходства 0–1: ниже этого результаты не показываются. По умолчанию 0.3; у разных моделей шкала разная.
EMBEDDINGS_MIN_SCORE=
