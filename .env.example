# --- Вход через Telegram (OIDC) ---
# Пока переменные не заданы, раздел /dashboard открыт без входа.

# Секрет подписи сессии, не короче 32 символов. Например: openssl rand -base64 48
AUTH_SECRET=

# @BotFather -> бот -> Login Widget: Client ID и Client Secret
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Telegram ID тех, кому разрешён вход, через запятую. Без списка вход закрыт всем.
TELEGRAM_ALLOWED_IDS=

# Публичный адрес сайта (необязательно). В @BotFather добавьте в Allowed URLs:
#   <AUTH_URL>  и  <AUTH_URL>/api/auth/telegram/callback
AUTH_URL=https://wiki.example.com
